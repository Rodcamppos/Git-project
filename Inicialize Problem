def generate(numRows):
    triangle = []
    for i in range(numRows): 
        row = [1] * (i + 1) 
        for j in range(1, i): 
            row[j] = triangle[i - 1][j - 1] + triangle[i - 1][j] #aqui,se adiciona os números da linha acima, como no Triângulo de Pascal
        triangle.append(row) #adiciona a lista da linha feita à grande lista do triângulo

    return triangle #retorna a lista dos níveis do triângulo

           


   
